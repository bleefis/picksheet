{
  "rules": {
    "order-config": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['items'])"
    },
    "products": {
      ".read": true,
      ".write": true,
      ".validate": "newData.hasChildren(['items'])"
    },
    "prices": {
      ".read": true,
      ".write": false
    },
    "orders": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['createdAt'])",
        "email": {
          ".write": "!data.exists()"
        },
        "start": {
          ".write": "!data.exists()"
        }
      }
    },
    "price-history": {
      ".read": false,
      ".write": false
    },
    "price-reports": {
      ".read": true,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
